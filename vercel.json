{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/transcript-clear-all": false
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai/research.js": {
      "maxDuration": 60
    },
    "api/ai/modality-summary.js": {
      "maxDuration": 240
    }
  }
}
